      {
        "text": "前往右側的【時空檔案庫】，翻閱第零號觀測紀錄",
        "next": "d14_archive_vault"
      },
      {
        "text": "直接強行推開刻著 03:18 的【破曉天頂門】",
        "next": "d14_premature_gate"
      }
    ],
    "hasOnEnter": true,
